+class NoFeasibleService(RuntimeError):
+    """Explicit unsupported no-service case, never a profitable numeric alternative.
+
+    Zero completed operations do not imply zero market demand. Fixed costs,
+    FullPnL and cash cannot be inferred from this variable-flow model.
+    Consumers main/ramp deliberately propagate this error before unpacking.
+    """
+    def __init__(self, status):
+        self.status = status
+        self.operations = dict(aircraft_working=0, aircraft_reserved=0, flights_week=0,
+                               segments_year=0, od_trips_year=0, sales=0,
+                               variable_cost=0, subsidy=0, migrated=0, forgone=0)
+        self.fixed_cost = self.full_pnl = self.cash = None
+        super().__init__(status + ": no service; numeric comparison/export unsupported")
+
+
+def require_working_resource(A):
+    if not all(math.isfinite(A[k]) and A[k] >= 0 for k in ("fleet_cap", "spare_aircraft")):
