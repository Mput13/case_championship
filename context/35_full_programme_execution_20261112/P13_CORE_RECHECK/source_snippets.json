    "lines": [
      {
        "line": 296,
        "text": "    def historical_ledger(source):"
      },
      {
        "line": 297,
        "text": "        # Recompute in fixed mode only to compare realised ledgers, without"
      },
      {
        "line": 298,
        "text": "        # recursively entering adaptation. This also covers generated payments:"
      },
      {
        "line": 299,
        "text": "        # changing a future competitor must not rewrite a past customer advance."
      },
      {
        "line": 300,
        "text": "        fixed = copy.deepcopy(source)"
      },
      {
        "line": 301,
        "text": "        fixed[\"context\"][\"evaluation_mode\"] = \"fixed_programme\""
      },
      {
        "line": 302,
        "text": "        result = evaluate(fixed)"
      },
      {
        "line": 303,
        "text": "        money = result[\"finance\"]"
      },
      {
        "line": 304,
        "text": "        def rounded(value):"
      },
      {
        "line": 305,
        "text": "            return round(value, 8) if isinstance(value, float) else value"
      },
      {
        "line": 306,
        "text": "        accruals = {e[\"economic_event_id\"]: (e[\"accrual_month\"], e[\"owner\"], e[\"category\"], rounded(e[\"quantity\"]), rounded(e[\"amount\"]))"
      },
      {
        "line": 307,
        "text": "                    for e in money[\"economic_events\"] if e[\"accrual_month\"] < decision[:7]}"
      },
      {
        "line": 308,
        "text": "        cash = {e[\"cash_event_id\"]: (e[\"payment_date\"], e[\"economic_event_id\"], e[\"category\"], rounded(e[\"amount_signed\"]))"
      },
      {
        "line": 309,
        "text": "                for e in money[\"cash_events\"] if date_floor(e[\"payment_date\"]) < decision}"
      },
      {
        "line": 310,
        "text": "        return accruals, cash"
      },
      {
        "line": 311,
        "text": ""
      },
      {
        "line": 312,
        "text": "    require(historical_ledger(bundle) == historical_ledger(parent),"
      },
      {
        "line": 313,
        "text": "            \"adaptation rewrites historical derived accruals or cash\")"
      }
    ]
  },
