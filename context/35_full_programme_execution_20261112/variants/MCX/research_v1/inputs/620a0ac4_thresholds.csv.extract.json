[
  {
    "source_line": 2,
    "row": {
      "threshold_id": "TH-FIXED",
      "field": "max_affordable_incremental_fixed_monthly",
      "formula": "(R+S-C_variable-C_aircraft_use-D&A-C_launch_exp-C_exit_exp)/active_base_months",
      "unit": "RUB/base/month",
      "conditions": "active_base_months>0; all other terms fixed and defined",
      "assumption_id": "P04-A-THRESHOLD"
    }
  },
  {
    "source_line": 3,
    "row": {
      "threshold_id": "TH-LAUNCH",
      "field": "max_affordable_one_time_launch_expense",
      "formula": "sum(R+S-C_variable-C_fixed-C_aircraft_use-D&A-C_exit_exp)",
      "unit": "RUB/launch",
      "conditions": "Given horizon; not discounted investment threshold or finance capacity",
      "assumption_id": "P04-A-THRESHOLD"
    }
  },
  {
    "source_line": 4,
    "row": {
      "threshold_id": "TH-MRO",
      "field": "max_affordable_MRO_hourly",
      "formula": "(R+S-C_excluding_MRO)/block_hours",
      "unit": "RUB/block_h",
      "conditions": "MRO calendar/cycle fees separately counted; no joint claim all unknowns at separate maxima",
      "assumption_id": "P04-A-THRESHOLD"
    }
  },
  {
    "source_line": 5,
    "row": {
      "threshold_id": "TH-SUPPORT",
      "field": "required_recognisable_support",
      "formula": "C_full_operating-R_net",
      "unit": "RUB/period",
      "conditions": "Compare against eligibility/contract cap; legal cap does not imply award",
      "assumption_id": "P04-A-THRESHOLD"
    }
  },
  {
    "source_line": 6,
    "row": {
      "threshold_id": "TH-FUEL",
      "field": "max_effective_net_fuel_price",
      "formula": "(R+S_nonfuel-C_nonfuel_full)/eligible_consumed_t",
      "unit": "RUB/t",
      "conditions": "Separate nonqualifying fuel and future excise cash; fixed sales arithmetic only",
      "assumption_id": "P04-A-THRESHOLD"
    }
  },
  {
    "source_line": 7,
    "row": {
      "threshold_id": "TH-FARE",
      "field": "break_even_net_journey_yield",
      "formula": "(C_full_operating-S)/unique_sold_journeys",
      "unit": "RUB/journey",
      "conditions": "Fare changes require demand reassignment in P06; no fixed-pax market forecast",
      "assumption_id": "P04-A-THRESHOLD"
    }
  },
  {
    "source_line": 8,
    "row": {
      "threshold_id": "TH-COFINANCE",
      "field": "minimum_incremental_regional_or_commercial_funding",
      "formula": "max(0,required_support-confirmed_federal_support)",
      "unit": "RUB/period",
      "conditions": "Keep no-award baseline; regional cofinance must have its own signed terms",
      "assumption_id": "P04-A-THRESHOLD"
    }
  },
  {
    "source_line": 9,
    "row": {
      "threshold_id": "TH-FUNDING",
      "field": "required_committed_liquidity",
      "formula": "max(0,-min_event(cumsum(project_cash_before_financing)))",
      "unit": "RUB",
      "conditions": "Include prelaunch/exits and terminal liabilities; unknown dates imply unknown peak",
      "assumption_id": "P04-A-THRESHOLD"
    }
  },
  {
    "source_line": 10,
    "row": {
      "threshold_id": "TH-DELAY",
      "field": "support_delay_extra_bridge_constant_flow",
      "formula": "eligible_monthly_support * extra_unpaid_months",
      "unit": "RUB",
      "conditions": "Steady monthly toy flow only; actual event cash path may differ",
      "assumption_id": "P04-A-THRESHOLD"
    }
  },
  {
    "source_line": 11,
    "row": {
      "threshold_id": "TH-OPTION",
      "field": "new_base_vs_existing_base_operating_headroom",
      "formula": "result_before_new_base_costs_new - result_before_extra_costs_existing",
      "unit": "RUB/period",
      "conditions": "Common fleet/KEEP and common input versions; subtract only truly different uncounted costs",
