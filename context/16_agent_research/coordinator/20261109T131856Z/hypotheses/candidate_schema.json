{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Wings research candidate v1",
  "description": "Queue cards are not flight programs. A non-null program requires dated legs and versioned evidence; no unknown numerical values are filled by this schema.",
  "type": "object",
  "required": [
    "candidate_id",
    "title",
    "network_form",
    "operating_base",
    "proposed_paths",
    "passenger_and_purpose",
    "season_and_stay",
    "current_alternative",
    "rw_product",
    "growth_sources",
    "competitor_and_response",
    "frequency_proposal",
    "resource_requirement",
    "stop_rule",
    "ancestor_ids",
    "candidate_version",
    "author",
    "family_provenance",
    "selected_for_deepening",
    "selection_rationale",
    "experiment_id",
    "specific_test",
    "data_request_ids",
    "demand_value",
    "demand_unit",
    "demand_status",
    "demand_missing_reason",
    "net_fare_rub",
    "net_fare_status",
    "net_fare_definition",
    "frequency_status",
    "available_aircraft",
    "resource_status",
    "evaluation_status",
    "specification_status",
    "value_type",
    "acquisition_status",
    "primary_evidence_ids",
    "reward",
    "risk",
    "political_change_date",
    "program_manifest"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
    },
    "title": {
      "type": "string"
    },
    "network_form": {
      "type": "string"
    },
    "operating_base": {
      "type": "string"
    },
    "proposed_paths": {
      "type": "string"
    },
    "passenger_and_purpose": {
      "type": "string"
    },
    "season_and_stay": {
      "type": "string"
    },
    "current_alternative": {
      "type": "string"
    },
    "rw_product": {
      "type": "string"
    },
    "growth_sources": {
      "type": "string"
    },
    "competitor_and_response": {
      "type": "string"
    },
    "frequency_proposal": {
      "type": "string"
    },
    "resource_requirement": {
      "type": "string"
    },
    "stop_rule": {
      "type": "string"
    },
    "ancestor_ids": {
      "type": "string"
    },
    "candidate_version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "family_provenance": {
      "type": "string"
    },
    "selected_for_deepening": {
      "type": "boolean"
    },
    "selection_rationale": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "specific_test": {
      "type": "string"
    },
    "data_request_ids": {
      "type": "string"
    },
    "demand_value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "demand_unit": {
      "type": "string"
    },
    "demand_status": {
      "enum": [
        "OBSERVED",
        "DERIVED",
        "MODEL_ESTIMATE",
        "SCENARIO",
        "UNKNOWN"
      ]
    },
    "demand_missing_reason": {
      "type": "string"
    },
    "net_fare_rub": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "net_fare_status": {
      "enum": [
        "OBSERVED",
        "DERIVED",
        "MODEL_ESTIMATE",
        "SCENARIO",
        "UNKNOWN"
      ]
    },
    "net_fare_definition": {
      "type": "string"
    },
    "frequency_status": {
      "enum": [
        "OBSERVED",
        "DERIVED",
        "MODEL_ESTIMATE",
        "SCENARIO",
        "UNKNOWN"
      ]
    },
    "available_aircraft": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "resource_status": {
      "enum": [
        "OBSERVED",
        "DERIVED",
        "MODEL_ESTIMATE",
        "SCENARIO",
        "UNKNOWN"
      ]
    },
    "evaluation_status": {
      "enum": [
        "NOT_EVALUATED",
        "PARTIAL_GEOMETRY_ONLY",
        "CONDITIONALLY_EVALUATED",
        "FAILED_CONSTRAINT",
        "HELD_DATA",
        "RETIRED_WITH_REASON"
      ]
    },
    "specification_status": {
      "type": "string"
    },
    "value_type": {
      "enum": [
        "OBSERVED",
        "DERIVED",
        "MODEL_ESTIMATE",
        "SCENARIO",
        "UNKNOWN"
      ]
    },
    "acquisition_status": {
      "type": "string"
    },
    "primary_evidence_ids": {
      "type": "string"
    },
    "reward": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "political_change_date": {
      "type": "null",
      "description": "No political date forecasts in this research"
    },
    "program_manifest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/program"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "measure": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "period",
        "value_type",
        "source_ids",
        "missing_reason"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "value_type": {
          "enum": [
            "OBSERVED",
            "DERIVED",
            "MODEL_ESTIMATE",
            "SCENARIO",
            "UNKNOWN"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "missing_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "program": {
      "type": "object",
      "required": [
        "period",
        "baseline_id",
        "data_manifest_sha256",
        "evaluator_version",
        "scenario_version",
        "resource_budget_id",
        "operating_legs",
        "products",
        "local_module_ids",
        "switching_costs",
        "hypothesis_family_id"
      ],
      "properties": {
        "period": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": false
        },
        "baseline_id": {
          "type": "string"
        },
        "data_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluator_version": {
          "type": "string"
        },
        "scenario_version": {
          "type": "string"
        },
        "resource_budget_id": {
          "type": "string"
        },
        "hypothesis_family_id": {
          "type": "string"
        },
        "local_module_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "switching_costs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measure"
          }
        },
        "operating_legs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/leg"
          }
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/product"
          }
        }
      },
      "additionalProperties": false
    },
    "leg": {
      "type": "object",
      "required": [
        "leg_id",
        "origin_airport_id",
        "destination_airport_id",
        "departure_utc",
        "arrival_utc",
        "departure_timezone",
        "arrival_timezone",
        "aircraft_resource_id",
        "leg_role",
        "seats",
        "source_snapshot_ids"
      ],
      "properties": {
        "leg_id": {
          "type": "string"
        },
        "origin_airport_id": {
          "type": "string"
        },
        "destination_airport_id": {
          "type": "string"
        },
        "departure_utc": {
          "type": "string",
          "format": "date-time"
        },
        "arrival_utc": {
          "type": "string",
          "format": "date-time"
        },
        "departure_timezone": {
          "type": "string"
        },
        "arrival_timezone": {
          "type": "string"
        },
        "aircraft_resource_id": {
          "type": "string"
        },
        "leg_role": {
          "enum": [
            "commercial",
            "positioning",
            "reserve_recovery"
          ]
        },
        "seats": {
          "$ref": "#/$defs/measure"
        },
        "source_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": [
        "product_id",
        "origin_airport_id",
        "destination_airport_id",
        "outbound_leg_ids",
        "return_leg_ids",
        "purpose",
        "stay_nights",
        "protection",
        "net_revenue",
        "demand_input_id",
        "own_migration_input_id"
      ],
      "properties": {
        "product_id": {
          "type": "string"
        },
        "origin_airport_id": {
          "type": "string"
        },
        "destination_airport_id": {
          "type": "string"
        },
        "outbound_leg_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "return_leg_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "purpose": {
          "type": "string"
        },
        "stay_nights": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "protection": {
          "enum": [
            "contract_verified",
            "scenario_only",
            "self_connect",
            "not_applicable"
          ]
        },
        "net_revenue": {
          "$ref": "#/$defs/measure"
        },
        "demand_input_id": {
          "type": "string"
        },
        "own_migration_input_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "demand_status": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "demand_value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "net_fare_status": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "net_fare_rub": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_status": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "available_aircraft": {
            "type": "null"
          }
        }
      }
    }
  ]
}
