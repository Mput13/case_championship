3e\u0439 \u041d\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a, \u0417\u0430\u043f\u043e\u0440\u043e\u0436\u0441\u043a\u043e\u0439 \u0438 \u0425\u0435\u0440\u0441\u043e\u043d\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439). \u0415\u0434\u0438\u043d\u0438\u0446\u0430 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u2014 \u0447\u0435\u043b\u043e\u0432\u0435\u043a. \u041f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u043d\u043e\u0441\u0442\u044c: \u0435\u0436\u0435\u0433\u043e\u0434\u043d\u043e \u0438 \u0435\u0436\u0435\u043a\u0432\u0430\u0440\u0442\u0430\u043b\u044c\u043d\u043e.", "dataset_granularity_en": "Year", "dataset_granularity_ru": "\u0413\u043e\u0434", "dataset_keyword_en": ["health care", "recreation", "residents", "health resorts", "socioeconomic development of the Russian Federation", "tourism"], "dataset_keyword_ru": ["\u0437\u0434\u0440\u0430\u0432\u043e\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435", "\u043e\u0442\u0434\u044b\u0445", "\u0440\u0430\u0437\u043c\u0435\u0449\u0435\u043d\u043d\u044b\u0435 \u043b\u0438\u0446\u0430", "\u0441\u0430\u043d\u0430\u0442\u043e\u0440\u043d\u043e-\u043a\u0443\u0440\u043e\u0440\u0442\u043d\u044b\u0435 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438", "\u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e-\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0440\u0444", "\u0442\u0443\u0440\u0438\u0437\u043c"], "dataset_license_en": "CC-BY (attribution required). 3.0. Worldwide", "dataset_license_ru": "CC-BY (\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0430\u0432\u0442\u043e\u0440\u0441\u0442\u0432\u0430). 3.0. \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u0430\u044f", "dataset_link": "https://www.fedstat.ru/indicator/42102", "dataset_methodology_en": "The total number of individuals who stayed at health resorts during the reporting period, regardless of their citizenship, purpose of stay, or length of stay.  For 2008\u20132015, annual data are presented excluding microenterprises. Quarterly data are presented excluding small businesses.\nStatistical data for the Russian Federation are published excluding statistical information on the Donetsk People\u2019s Republic (DPR), the Luhansk People\u2019s Republic (LPR), and the Zaporizhzhia and Kherson regions.", "dataset_methodology_ru": "\u0427\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0432\u0441\u0435\u0445 \u043b\u0438\u0446, \u0440\u0430\u0437\u043c\u0435\u0449\u0435\u043d\u043d\u044b\u0445 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043e\u0442\u0447\u0435\u0442\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u0432 \u0441\u0430\u043d\u0430\u0442\u043e\u0440\u043d\u043e-\u043a\u0443\u0440\u043e\u0440\u0442\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f\u0445, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0438\u0445 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u0442\u0432\u0430,  \u0446\u0435\u043b\u0438 \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u044f.  \u0417\u0430 2008-2015 \u0433\u0433. \u0433\u043e\u0434\u043e\u0432\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u0431\u0435\u0437 \u0443\u0447\u0435\u0442\u0430 \u043c\u0438\u043a\u0440\u043e\u043f\u0440\u0435\u0434\u043f\u0440\u0438\u044f\u0442\u0438\u0439.  \u041a\u0432\u0430\u0440\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u0431\u0435\u0437 \u0443\u0447\u0435\u0442\u0430 \u0441\u0443\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u043c\u0430\u043b\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430.\n\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u043e \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0438 \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u044e\u0442\u0441\u044f \u0431\u0435\u0437 \u0443\u0447\u0435\u0442\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u043f\u043e \u0414\u043e\u043d\u0435\u0446\u043a\u043e\u0439 \u041d\u0430\u0440\u043e\u0434\u043d\u043e\u0439 \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0435 (\u0414\u041d\u0420), \u041b\u0443\u0433\u0430\u043d\u0441\u043a\u043e\u0439 \u041d\u0430\u0440\u043e\u0434\u043d\u043e\u0439 \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0435 (\u041b\u041d\u0420), \u0417\u0430\u043f\u043e\u0440\u043e\u0436\u0441\u043a\u043e\u0439 \u0438 \u0425\u0435\u0440\u0441\u043e\u043d\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u044f\u043c", "dataset_period": {"from": "2002-01-01", "to": "2025-12-31"}, "dataset_title_en": "Number of People Staying at Health Resorts, Russia, 2008\u20132015 (2002 - 2025)", "dataset_title_ru": "\u0427\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0437\u043c\u0435\u0449\u0435\u043d\u043d\u044b\u0445 \u043b\u0438\u0446 \u0432 \u0441\u0430\u043d\u0430\u0442\u043e\u0440\u043d\u043e-\u043a\u0443\u0440\u043e\u0440\u0442\u043d\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f\u0445, \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0420\u043e\u0441\u0441\u0438\u044f, 2008-2015 (2002 - 2025)", "dataset_topics_en": ["Tourism"], "dataset_topics_ru": ["\u0422\u0443\u0440\u0438\u0437\u043c"], "dataset_units": ["\u0447\u0435\u043b\u