e\u0441\u0442\u0438 \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u044f..  \u0413\u043e\u0434\u043e\u0432\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u043f\u043e \u043f\u043e\u043b\u043d\u043e\u043c\u0443 \u043a\u0440\u0443\u0433\u0443 \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0441\u0443\u0431\u044a\u0435\u043a\u0442\u043e\u0432..  \u041a\u0432\u0430\u0440\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0437\u0430 2011-2015 \u0433\u0433. \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u0431\u0435\u0437 \u0443\u0447\u0435\u0442\u0430 \u0441\u0443\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u043c\u0430\u043b\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430. \u041d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 \u043e\u0442\u0447\u0435\u0442\u0430 \u0437\u0430 \u044f\u043d\u0432\u0430\u0440\u044c-\u043c\u0430\u0440\u0442 2016 \u0433. \u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u043f\u043e \u043f\u043e\u043b\u043d\u043e\u043c\u0443 \u043a\u0440\u0443\u0433\u0443 \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0441\u0443\u0431\u044a\u0435\u043a\u0442\u043e\u0432.\n&amp;nbsp;  &amp;nbsp; \u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u043e \u0420\u043e\u0441\u0441\u0438\u0439\u0441\u043a\u043e\u0439 \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0438 \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u044e\u0442\u0441\u044f \u0431\u0435\u0437 \u0443\u0447\u0435\u0442\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u043f\u043e \u0414\u043e\u043d\u0435\u0446\u043a\u043e\u0439 \u041d\u0430\u