HOST=127.0.0.1
PORT=3080
# Explicit mode. Live never falls back to snapshot.
SCHEDULE_MODE=snapshot
YANDEX_RASP_API_KEY=
YANDEX_RASP_BASE_URL=https://api.rasp.yandex-net.ru/v3.0/
# All values below are server-only. Leave generation disabled until verified.
ENABLE_LLM=false
AGENT_ENGINE=pi
MAX_LLM_CALLS=20
MAI_BASE_URL=https://api-ai.mai.ru
MAI_MODEL=deepseek-v4.1-flash
MAI_API_KEY=
# Alternative: absolute path to a protected file, outside public/ and this repo.
MAI_API_KEY_FILE=
# Set explicitly only after coordinator verifies the protocol and endpoint.
MAI_PROTOCOL=openai-chat-completions
MAI_CHAT_PATH=/v1/chat/completions
MAI_CA_FILE=./certs/russian-trusted-root.pem
HTTP_TIMEOUT_MS=10000
LLM_TIMEOUT_MS=20000
# Optional HTTPS origin when hosted behind a trusted reverse proxy.
PUBLIC_ORIGIN=
